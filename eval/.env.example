# Copy to .env and edit. `python -m dlsbench.eval` loads .env automatically; real environment
# variables win over it.
#
# Fill in blocks 1-3 (block 3 is needed for Acc). Everything after them has a working default.

# ============================================================ 1. YOUR MODEL
# Any endpoint that speaks the OpenAI chat-completions API with native tool calling. These three
# lines are the whole "swap in your own model" surface. MODEL_NAME also names the output files.
MODEL_NAME=gpt-5.4-mini
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=

# A local vLLM / SGLang server instead (vLLM needs --enable-auto-tool-choice --tool-call-parser ...):
#   MODEL_NAME=Qwen/Qwen3-32B
#   MODEL_BASE_URL=http://localhost:8000/v1
#   MODEL_API_KEY=EMPTY

# ============================================================ 2. SEARCH BACKENDS
# Web-ReAct (--harness web): Google results through serper.dev. Required for that harness.
SERPER_API_KEY=
# Jina Reader serves visit_page (web) and the full text in s2_paper (s2). Optional: without a key
# it works at a lower rate limit.
JINA_API_KEY=
# S2-ReAct (--harness s2): Semantic Scholar Graph API. Optional, but the shared unauthenticated
# pool is heavily rate-limited. S2_RPS is the request rate shared by all threads; raise it only as
# far as your key allows.
S2_API_KEY=
S2_RPS=1

# ============================================================ 3. GRADING
# The judge is gpt-5.4-mini, the paper's, called through the Responses API; only the key and
# endpoint are yours. OPENAI_API_KEY is used if JUDGE_API_KEY is unset. Set JUDGE_API=chat for an
# endpoint that only speaks chat-completions. Changing JUDGE_MODEL makes Acc incomparable.
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL=gpt-5.4-mini
# JUDGE_API=responses

# ============================================================ 4. TUNING (optional)
# Questions run in parallel.
CONCURRENCY=4
MODEL_TIMEOUT=300

# Optional request fields, sent only when set. The paper's runs sent no temperature and no output
# cap for OpenAI models, used reasoning effort "high" for the GPT-5.4 family, and set
# max_tokens=16000 for DeepSeek-V4-Pro served through Together.
# MODEL_REASONING_EFFORT=high
# MODEL_MAX_TOKENS=16000
# MODEL_TEMPERATURE=
